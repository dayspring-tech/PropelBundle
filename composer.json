{
  "name": "dayspring-tech/propel-bundle",
  "description": "Integration of Propel in Symfony2",
  "keywords": ["propel", "orm", "persistence"],
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [{
    "name": "William Durand",
    "email": "william.durand1@gmail.com"
  }],

  "autoload": {
    "psr-4": { "Propel\\Bundle\\PropelBundle\\": "" },
    "files": ["autoload_aliases.php"],
    "exclude-from-classmap": [ "Tests/" ]
  },

  "require": {
    "php": ">=8.1",
    "dayspring-tech/propel1": "^1.8.0",
    "symfony/framework-bundle": "^5.4|^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.1",
    "phing/phing": "^2.12",
    "symfony/symfony": "^5.4|^6.0",
    "sensio/framework-extra-bundle": "^4.0|^5.0|^6.0",
    "fakerphp/faker": "^1.10",
    "symfony/phpunit-bridge": "^5.4|^6.0",
    "mikey179/vfsstream": "^1.6.7"
    "rector/rector": "^1.0"
  },

  "replace": {
    "symfony/propel1-bridge": ">=2.8.0",
    "propel/propel-bundle": "^1.8.0"
  },

  "suggest": {
    "propel/propel-acl-bundle": "For using the Propel ACL implementation"
  },

  "scripts": {
    "ci-test": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/phpunit/phpunit/phpunit -c ./phpunit.xml.dist"
    ]
  }
}
