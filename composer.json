{
  "name": "propel/propel-bundle",
  "description": "Integration of Propel in Symfony2",
  "keywords": ["propel", "orm", "persistence"],
  "type": "symfony-bundle",
  "license": "MIT",
  "authors": [{
    "name": "William Durand",
    "email": "william.durand1@gmail.com"
  }],

  "autoload": {
    "psr-4": { "Propel\\Bundle\\PropelBundle\\": "" },
    "files": ["autoload_aliases.php"],
    "exclude-from-classmap": [ "Tests/" ]
  },

  "require": {
    "propel/propel1": "dev-feature/php8.0",
    "symfony/framework-bundle": "^4.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.0",
    "phing/phing": "^2.12",
    "symfony/symfony": "^4.4",
    "sensio/framework-extra-bundle": "^4.0",
    "fakerphp/faker": "^1.10",
    "symfony/phpunit-bridge": "^4.4"
  },

  "conflict": {
    "symfony/propel1-bridge": ">=2.8.0"
  },

  "replace": {
    "symfony/propel1-bridge": "<=2.8.0"
  },

  "suggest": {
    "propel/propel-acl-bundle": "For using the Propel ACL implementation"
  },

  "scripts": {
    "ci-test": [
      "Composer\\Config::disableProcessTimeout",
      "vendor/phpunit/phpunit/phpunit -c ./phpunit.xml.dist"
    ]
  },
  "repositories": [
    {
      "type": "vcs",
      "url":  "git@github.com:dayspring-tech/Propel.git"
    }
  ]
}
